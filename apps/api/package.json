{
  "name": "@nowly/api",
  "description": "Nowly API for accounts, presence distribution, device pairing and public activity sharing.",
  "homepage": "https://nowly.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/nowly-presence/nowly.git",
    "directory": "apps/api"
  },
  "bugs": {
    "url": "https://github.com/nowly-presence/nowly/issues"
  },
  "version": "1.2.2",
  "license": "MIT",
  "contributors": [
    {
      "name": "Gaëtan H",
      "url": "https://github.com/Steellgold"
    },
    {
      "name": "Anthony (KiMi)",
      "url": "https://github.com/q-kimi"
    }
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "lint:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:reset-dev": "tsx scripts/reset-dev-data.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@nowly/env": "workspace:*",
    "@nowly/locales": "workspace:*",
    "@nowly/shared": "workspace:*",
    "@nowly/telemetry": "workspace:*",
    "@opencoredev/email-sdk": "^3.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.12",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.9",
    "prisma": "^7.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
