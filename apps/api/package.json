  "license": "BUSL-1.1",
  "contributors": [
    {
      "name": "KiMi",
      "url": "https://github.com/q-kimi"
    }
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "pnpm run typecheck && pnpm run lint:test",
    "lint:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:reset-dev": "tsx scripts/reset-dev-data.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@nowly/env": "workspace:*",
    "@nowly/locales": "workspace:*",
    "@nowly/sdk": "workspace:*",
    "@nowly/shared": "workspace:*",
    "@opencoredev/email-sdk": "^0.6.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-email": "^6.6.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
