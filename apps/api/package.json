{
  "name": "@nowly/api",
  "description": "Nowly API for accounts, presence distribution, device pairing and public activity sharing.",
  "homepage": "https://nowly.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/nowly-presence/nowly.git",
    "directory": "apps/api"
  },
  "bugs": {
    "url": "https://github.com/nowly-presence/nowly/issues"
  },
  "version": "1.2.2",
  "license": "MIT",
  "contributors": [
    {
      "name": "Gaëtan H",
      "url": "https://github.com/Steellgold"
    },
    {
      "name": "Anthony (KiMi)",
      "url": "https://github.com/q-kimi"
    }
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "lint:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:reset-dev": "tsx scripts/reset-dev-data.ts",
    "db:migrate": "pnpm --filter @nowly/database migrate",
    "role:set": "tsx src/cli/set-role.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@hono/node-server": "^1.19.18",
    "@nowly/auth": "workspace:*",
    "@nowly/database": "workspace:*",
    "@nowly/env": "workspace:*",
    "@nowly/locales": "workspace:*",
    "@nowly/presence-creator": "workspace:*",
    "@nowly/shared": "workspace:*",
    "@nowly/telemetry": "workspace:*",
    "@opencoredev/email-sdk": "^3.0.1",
    "better-auth": "^1.7.14",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.9",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
