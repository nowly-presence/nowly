  "contributors": [
    {
      "name": "KiMi",
      "url": "https://github.com/q-kimi"
    }
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "pnpm run typecheck && pnpm run lint:test",
    "lint:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:reset-dev": "tsx scripts/reset-dev-data.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@nowly/analytics": "workspace:*",
    "@nowly/env": "workspace:*",
    "@nowly/locales": "workspace:*",
    "@nowly/shared": "workspace:*",
    "@opencoredev/email-sdk": "^1.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "prisma": "^7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
