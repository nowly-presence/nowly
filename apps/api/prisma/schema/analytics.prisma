model AnalyticsEvent {
  eventId   String   @id @map("event_id")
  key       String
  deviceId  String?  @map("device_id")
  slug      String?
  version   String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([key, createdAt])
  @@index([deviceId])
  @@map("analytics_events")
}
