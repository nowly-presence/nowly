model Presence {
  slug      String    @id
  metadata  Json      @default("{}")
  version   String?
  archived  Boolean   @default(false)
  addedAt   DateTime? @map("added_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  versions PresenceVersion[]

  @@map("presences")
}

model PresenceVersion {
  slug                 String
  version              String
  changelog            String   @default("")
  author               String   @default("unknown")
  authorGithub         String?  @map("author_github")
  releaseAuthor        String?  @map("release_author")
  releaseContributors  String?  @map("release_contributors")
  pr                   String?
  source               String?
  commitSha            String?  @map("commit_sha")
  changedFiles         String?  @map("changed_files")
  bundleSizeBytes      Int?     @map("bundle_size_bytes")
  bundleSizeLabel      String?  @map("bundle_size_label")
  bundleSha256         String?  @map("bundle_sha256")
  versionType          String?  @map("version_type")
  aiGeneratedChangelog Boolean? @map("ai_generated_changelog")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  timestamp            DateTime @default(now()) @db.Timestamptz(6)

  presence Presence @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@id([slug, version])
  @@index([slug])
  @@map("presence_versions")
}
