model InsightsView {
  id        String   @id @default(cuid())
  name      String
  createdBy String   @map("created_by")
  widgets   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("insights_views")
}
