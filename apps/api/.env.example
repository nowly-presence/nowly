# Server listening port (default: 3001)
PORT=3001

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Insights dashboard URL (CORS) - internal, not public-facing yet
INSIGHTS_URL=http://localhost:3002

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/database

# Secret key for signing JWTs
JWT_SECRET=

#
# Discord OAuth
#
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

#
# Better Auth (not wired into the extension/web yet - gates /insights/* for admin accounts)
#
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Private key (DER, base64url-encoded) for signing presence releases
PRESENCE_SIGNING_PRIVATE_KEY=

# API secret key for protected endpoints
API_SECRET_KEY=

# Secret key for device token generation
DEVICE_TOKEN_SECRET=

# OpenAI API key (optional, for AI features)
OPENAI_API_KEY=

#
# Status / Health checks
#
# Secret for status cron endpoints
STATUS_CRON_SECRET=
# Interval in hours between each status check
STATUS_CHECK_INTERVAL_HOURS=1
# Number of status samples to keep
STATUS_SAMPLE_LIMIT=168

# Presence issue reports from the library page
DISCORD_WEBHOOK_REPORT_URL=https://discord.com/api/webhooks/...
