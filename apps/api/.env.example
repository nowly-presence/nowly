# Server listening port (default: 3001)
PORT=3001

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/database

# Secret key for signing JWTs
JWT_SECRET=

# Secret key for hashing anonymous identifiers
ANONYMOUS_HASH_SECRET=

#
# Discord OAuth
#
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# Private key (DER, base64url-encoded) for signing presence releases
PRESENCE_SIGNING_PRIVATE_KEY=

# API secret key for protected endpoints
API_SECRET_KEY=

# Discord IDs allowed to access analytics (comma-separated, leave empty to disable)
ANALYTICS_ALLOWED_DISCORD_IDS=

# Secret key for device token generation
DEVICE_TOKEN_SECRET=

# OpenAI API key (optional, for AI features)
OPENAI_API_KEY=

#
# Status / Health checks
#
# Secret for status cron endpoints
STATUS_CRON_SECRET=
# Interval in hours between each status check
STATUS_CHECK_INTERVAL_HOURS=1
# Number of status samples to keep
STATUS_SAMPLE_LIMIT=168

#
# AWS SES (emails)
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

#
# Support / Sponsor emails
#
SUPPORT_REDEEM_URL=https://nowly.me/redeem
# Default max devices allowed for a support pass
SUPPORT_PASS_DEFAULT_MAX_DEVICES=5

#
# Donation webhooks
#
KOFI_WEBHOOK_TOKEN=
GITHUB_SPONSORS_WEBHOOK_SECRET=

#
# Discord webhooks (notifications)
#
DISCORD_WEBHOOK_SUCCESS_URL=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_FAILURE_URL=https://discord.com/api/webhooks/...