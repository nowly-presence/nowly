{
  "name": "@nowly/extension",
  "version": "2.0.0",
  "author": {
    "name": "Gaëtan H",
    "url": "https://github.com/Steellgold"
  },
  "license": "BUSL-1.1",
  "contributors": [
    {
      "name": "KiMi",
      "url": "https://github.com/q-kimi"
    }
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts chrome",
    "build:chrome": "tsx scripts/build.ts chrome",
    "build:firefox": "tsx scripts/build.ts firefox",
    "build:dev": "tsx scripts/build-dev.ts chrome",
    "build:dev:chrome": "tsx scripts/build-dev.ts chrome",
    "build:dev:firefox": "tsx scripts/build-dev.ts firefox",
    "package": "tsx --tsconfig scripts/tsconfig.json scripts/package.ts all",
    "package:chrome": "tsx --tsconfig scripts/tsconfig.json scripts/package.ts chrome",
    "package:firefox": "tsx --tsconfig scripts/tsconfig.json scripts/package.ts firefox",
    "package:source": "tsx --tsconfig scripts/tsconfig.json scripts/package-source.ts",
    "dev": "vite build --watch",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@nowly/analytics": "workspace:*",
    "@nowly/env": "workspace:*",
    "@nowly/locales": "workspace:*",
    "@nowly/shared": "workspace:*",
    "@tabler/icons-react": "^3.46.0",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "sharp": "^0.34.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vite": "^8.3.0"
  }
}
