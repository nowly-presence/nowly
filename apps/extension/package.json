{
  "name": "@nowly/extension",
  "version": "2.5.0.1",
  "description": "Nowly browser extension for automatic website activity detection, custom activities and Discord Rich Presence.",
  "contributors": [
    {
      "name": "Gaëtan H",
      "url": "https://github.com/Steellgold"
    },
    {
      "name": "Anthony (KiMi)",
      "url": "https://github.com/q-kimi"
    }
  ],
  "homepage": "https://nowly.me/extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/nowly-presence/nowly.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/nowly-presence/nowly/issues"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx scripts/build.ts chrome --canary --watch",
    "watch:canary": "tsx scripts/build.ts chrome --canary --watch",
    "build": "tsx scripts/build.ts chrome && tsx scripts/build.ts firefox",
    "build:chrome": "tsx scripts/build.ts chrome --canary",
    "build:firefox": "tsx scripts/build.ts firefox --canary",
    "preview": "vite --config scripts/preview.config.ts",
    "package": "tsx scripts/package.ts",
    "package:chrome": "tsx scripts/package.ts chrome",
    "package:firefox": "tsx scripts/package.ts firefox",
    "package:source": "tsx --tsconfig scripts/tsconfig.json scripts/package-source.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nowly/telemetry": "workspace:*",
    "@nowly/env": "workspace:*",
    "@nowly/locales": "workspace:*",
    "@nowly/shared": "workspace:*",
    "@remixicon/react": "^4.9.0",
    "fflate": "^0.8.3",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.9"
  }
}
