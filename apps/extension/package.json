{
  "name": "@nowly/extension",
  "version": "2.2.2",
  "description": "Nowly browser extension (side panel) - share your web activity on Discord.",
  "private": true,
  "type": "module",
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "tsx scripts/build.ts chrome --canary --watch",
    "build": "tsx scripts/build.ts chrome && tsx scripts/build.ts firefox",
    "build:chrome": "tsx scripts/build.ts chrome --canary",
    "build:firefox": "tsx scripts/build.ts firefox --canary",
    "preview": "vite --config scripts/preview.config.ts",
    "package": "tsx scripts/package.ts",
    "package:chrome": "tsx scripts/package.ts chrome",
    "package:firefox": "tsx scripts/package.ts firefox",
    "package:source": "tsx --tsconfig scripts/tsconfig.json scripts/package-source.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nowly/analytics": "workspace:*",
    "@nowly/env": "workspace:*",
    "@nowly/locales": "workspace:*",
    "@nowly/shared": "workspace:*",
    "@remixicon/react": "^4.9.0",
    "fflate": "^0.8.3",
    "motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.9"
  }
}
