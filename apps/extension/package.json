{
  "name": "@nowly/extension",
  "version": "2.1.0",
  "author": {
    "name": "Gaëtan H",
    "url": "https://github.com/Steellgold"
  },
  "license": "BUSL-1.1",
  "contributors": [
    {
      "name": "KiMi",
      "url": "https://github.com/q-kimi"
    }
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts chrome",
    "build:chrome": "tsx scripts/build.ts chrome",
    "build:firefox": "tsx scripts/build.ts firefox",
    "build:canary": "tsx scripts/build.ts chrome --canary",
    "build:canary:firefox": "tsx scripts/build.ts firefox --canary",
    "dev": "tsx scripts/build.ts chrome --canary --watch",
    "package": "tsx --tsconfig scripts/tsconfig.json scripts/package.ts all",
    "package:chrome": "tsx --tsconfig scripts/tsconfig.json scripts/package.ts chrome",
    "package:firefox": "tsx --tsconfig scripts/tsconfig.json scripts/package.ts firefox",
    "package:source": "tsx --tsconfig scripts/tsconfig.json scripts/package-source.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@nowly/analytics": "workspace:*",
    "@nowly/env": "workspace:*",
    "@nowly/locales": "workspace:*",
    "@nowly/shared": "workspace:*",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.28",
    "sharp": "^0.34.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.9"
  }
}
