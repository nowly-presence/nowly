# Web base URL for marketplace links
VITE_WEB_BASE_URL=http://localhost:3000

# API base URL for presence data
VITE_API_BASE_URL=http://localhost:3001

# CDN base URL for published presence assets.
# Bundled / locally developed presences always load logo, icon, and thumbnail
# from the unpacked extension (`presences/{slug}/assets`), not from the CDN.
VITE_CDN_BASE_URL=https://cdn.nowly.me
