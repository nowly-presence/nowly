{
  "name": "@nowly/websites",
  "version": "0.0.1",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./cli/*": "./cli/*"
  },
  "scripts": {
    "build": "tsx --tsconfig cli/tsconfig.json cli/index.ts build",
    "cli": "tsx --tsconfig cli/tsconfig.json cli/index.ts",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nowly/env": "workspace:*",
    "@nowly/locales": "workspace:*",
    "@nowly/presence": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@types/node": "catalog:",
    "chalk": "catalog:",
    "commander": "catalog:",
    "dotenv": "catalog:",
    "enquirer": "^2.4.1",
    "esbuild": "catalog:",
    "ora": "^8.2.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
