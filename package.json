{
  "name": "presence",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "version": "1.2.2",
  "license": "MIT",
  "author": {
    "name": "Gaëtan H",
    "url": "https://github.com/Steellgold"
  },
  "contributors": [
    {
      "name": "KiMi",
      "url": "https://github.com/q-kimi"
    }
  ],
  "description": "Presence monorepo",
  "scripts": {
    "format": "node --experimental-strip-types scripts/format.ts",
    "test:format": "node --experimental-strip-types --test scripts/format.test.ts",
    "dev:api": "pnpm --filter @nowly/api dev",
    "dev:web": "pnpm --filter @nowly/web dev",
    "dev:docs": "pnpm --filter @nowly/docs dev",
    "prisma:generate": "pnpm --filter @nowly/api prisma:generate",
    "start:api": "pnpm --filter @nowly/api start",
    "typecheck:api": "pnpm --filter @nowly/api typecheck",
    "build:extension": "pnpm --filter @nowly/extension build",
    "build:extension:dev": "pnpm --filter @nowly/extension build:chrome",
    "build:macos": "cd apps/native && bash scripts/macos-release.sh",
    "admin": "pnpm --filter @nowly/internal-cli cli",
    "internal-cli": "pnpm --filter @nowly/internal-cli cli"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
