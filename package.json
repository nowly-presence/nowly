{
  "name": "presence",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "version": "1.2.2",
  "license": "BUSL-1.1",
  "author": {
    "name": "Gaëtan H",
    "url": "https://github.com/Steellgold"
  },
  "contributors": [
    { "name": "KiMi", "url": "https://github.com/q-kimi" }
  ],
  "description": "Presence monorepo",
  "scripts": {
    "dev:api": "pnpm --filter @nowly/api dev",
    "dev:web": "pnpm --filter @nowly/web dev",
    "build:websites": "pnpm --filter @nowly/websites build",
    "prisma:generate": "pnpm --filter @nowly/api prisma:generate",
    "start:api": "pnpm --filter @nowly/api start",
    "typecheck:api": "pnpm --filter @nowly/api typecheck",
    "build:extension": "pnpm --filter @nowly/extension build",
    "build:extension:dev": "pnpm --filter @nowly/extension build:dev",
    "admin:push": "pnpm internal-cli push",
    "admin": "pnpm internal-cli",
    "internal-cli": "tsx --tsconfig packages/internal-cli/tsconfig.json packages/internal-cli/index.ts",
    "admin:r2-sync": "pnpm internal-cli r2:sync",
    "admin:host-publish": "pnpm internal-cli host:publish",
    "build:macos": "cd apps/native && bash scripts/macos-release.sh"
  }
}
